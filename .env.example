# MediaShrink Cloud — plantilla de entorno (G-3)
# Copiar a .env para desarrollo local. NUNCA versionar el .env real ni secretos.
# Todos los valores de abajo son marcadores locales o rutas a archivos generados
# por el emulador; no hay credenciales AWS fijas (G-3, A-03).

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Límites de seguridad y procesamiento (D-08, IN-07, plan.md §4)
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=15
MAX_IMAGES_PER_BATCH=20
MAX_PIXELS=25000000

# ---------------------------------------------------------------------------
# JWT propio en Hono (D-06, A-02)
# Reemplazar ambos marcadores por secretos locales de 32+ caracteres en .env.
# Los TTL se expresan en SEGUNDOS; access debe ser menor que refresh.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_LOCAL_DEV_SECRET_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_LOCAL_DEV_SECRET_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---------------------------------------------------------------------------
# Rate limiting de autenticación (A-06)
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120

# ---------------------------------------------------------------------------
# Emulador local aws/aws-emulator (ADR-001) — sin credenciales fijas (G-3, A-03)
# El emulador genera credenciales nuevas en cada arranque. NO definir
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE: las variables de entorno
# tienen prioridad sobre los archivos generados y el emulador las rechazaría.
# AWS_ACCOUNT_ID es el identificador FIJO del emulador, no un secreto.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_SHARED_CREDENTIALS_FILE=./.local/aws-emulator/emulator_credentials
AWS_CONFIG_FILE=./.local/aws-emulator/config
AWS_EC2_METADATA_DISABLED=true
AWS_ACCOUNT_ID=000000000000
USE_SSL=true
CA_BUNDLE_PATH=./.local/aws-emulator/ca.pem

# ---------------------------------------------------------------------------
# Recursos aprovisionados por Terraform en el emulador
# SQS_QUEUE_URL / SQS_DLQ_URL son las QueueUrl que devuelve el emulador: host AWS
# estándar + cuenta fija. El tráfico se enruta al emulador con AWS_ENDPOINT_URL
# (https://127.0.0.1:9297), no con el host de la QueueUrl. En el SDK JS v3 usar
# useQueueUrlAsEndpoint:false. No existe el puerto 9324.
# ---------------------------------------------------------------------------
S3_BUCKET_RAW=mediashrink-raw-local
S3_BUCKET_OPTIMIZED=mediashrink-optimized-local
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/mediashrink-jobs
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/mediashrink-jobs-dlq
DYNAMODB_TABLE_JOBS=mediashrink-jobs

# ---------------------------------------------------------------------------
# Retención y worker (D-09, D-10, D-15)
# ---------------------------------------------------------------------------
RETENTION_DAYS=30
SQS_MAX_RETRIES=3
POLL_INTERVAL_MS=2000
